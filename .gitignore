# macOS
.DS_Store

# Xcode 用户状态（每台机器/每个人都不同，不应入库）
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# 构建产物
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode7v3
!default.mode7v3

# Swift Package Manager
.build/
# 本地下拉的包目录默认不入库（体积/机器相关）。
# SherpaKokoroKit 是**手写源码**，必须能进版本库；注意 `.build/` 已被上面的规则排除，
# 所以放行这个目录不会把 1.3G 的解析产物带进来。
Packages/*
!Packages/SherpaKokoroKit/
Package.pins

# 本地模型二进制（体积巨大，改由外部下载，不入版本库）
Reader/SparkTTSCache/
Reader/Qwen3TTSCache/
Reader/Qwen3-0.6B-MLX-4bit/

# Models（仓库根目录下的模型下载目录；`Reader/Models/` 是 Swift 源码，不能被排除，
# 模型权重另有 *.safetensors/*.bin 等规则兜底）
/Models/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Generated audio
*.wav
*.m4a
*.flac

# Build
.build/
DerivedData/

# Xcode
xcuserdata/
*.xcuserstate
